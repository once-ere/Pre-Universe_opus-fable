# =============================================================================
#  Pre-Universe_opus-fable  --  .gitignore
#
#  Three jobs, in order of importance:
#
#    1. no credential ever enters the history;
#    2. editor, OS, language and build litter stays out;
#    3. this project's own deliverables stay IN, and are never at the mercy of
#       an exception list somebody has to remember to update.
#
#  Job 3 is why there is no blanket "*.log" or "*.txt" rule. The evidence this
#  repository publishes -- executed notebooks, figures, JSON summaries, the
#  integrity manifest -- would be exactly the files such a rule would swallow.
#  Scratch is named, by the shapes scratch actually takes, so that a stray file
#  shows up in `git status` as untracked instead of vanishing.
#
#  Every rule below is either anchored with a leading "/" (matches only at the
#  repository root) or is a pattern no deliverable can match. The one negation,
#  in section 1, negates a FILE pattern rather than a directory, so nothing here
#  depends on gitignore's directory-ordering caveat.
#
#  The vendored engine at vendor/sundials_rs is a git submodule with its own
#  .gitignore; rules here do not apply inside it.
# =============================================================================


# -----------------------------------------------------------------------------
# 1.  SECRETS -- nothing matching these may ever be committed.
# -----------------------------------------------------------------------------

# environment and dotfile credential stores
.env
.env.*
!.env.example
.netrc
_netrc
.npmrc
.pypirc
.htpasswd

# keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.asc
*.gpg
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.ppk

# anything that names itself a credential
*credential*
*.secret
*.secrets
secrets.*
*token*.json
*_token
*.token

# Wolfram licensing material: a mathpass holds licence passwords and an
# activation key is a credential in exactly the way an API token is.
mathpass
*.mathpass
ActivationKey*
*activation-key*
*activation_key*

# tool and agent state, which can carry tokens or conversation transcripts
.claude/
.vscode/
.idea/
*.code-workspace


# -----------------------------------------------------------------------------
# 2.  LITTER -- editor, OS, language and build products.
# -----------------------------------------------------------------------------

# operating system
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# editors
*.swp
*.swo
*.swn
*~
.*.sw[a-z]

# Python: caches and the private virtual environment. requirements.txt is the
# tracked contract; the environment itself is rebuilt from it.
__pycache__/
*.py[cod]
.pytest_cache/
/.venv/
/.venv*/
.ipynb_checkpoints/

# Rust: Cargo build output. Unanchored on purpose so it also catches
# fable_cosmo_rs/target/ and any future crate.
target/

# LaTeX intermediates, anchored to the one directory holding .tex sources.
# scripts/build_documentation.sh writes them to /build/ (below) anyway; these
# rules catch a pdflatex run started by hand inside docs/. The .tex sources and
# the compiled .pdf reports ARE tracked.
/docs/*.aux
/docs/*.toc
/docs/*.out
/docs/*.lof
/docs/*.lot
/docs/*.synctex.gz
/docs/*.fls
/docs/*.fdb_latexmk
/docs/*.bbl
/docs/*.blg
/docs/*.nav
/docs/*.snm
/docs/*.vrb
/docs/*.xdv

# Wolfram: front-end backups and serialized dumps. The .wls sources and the
# evaluated .nb notebook ARE tracked.
*.nb.bak
*.mx
.MathematicaHistory

# duplicates the front end and file managers leave behind
*[Cc]opy*.wl
*[Cc]opy*.nb
*[Cc]opy*.mx


# -----------------------------------------------------------------------------
# 3.  SCRATCH AND REGENERABLE OUTPUT -- named by shape, never by extension.
# -----------------------------------------------------------------------------

# editor and tool backups, merge leftovers
*.tmp
*.temp
*.bak
*.bak.*
*.orig
*.rej
*.old

# files whose NAME says they are scratch
scratch*
Scratch*
tmp[-_.]*
temp[-_.]*
untitled*
Untitled*
*-scratch.*
*[-_]draft.*

# Pre-modification snapshots taken before every edit. Byte copies of tracked
# files; they must never be published alongside the originals.
/backups/

# Command output and generated render products. Every gate writes its log here
# and scripts/build_documentation.sh compiles into /build/. Both are regenerated
# by the documented commands and are inputs to nothing.
/logs/
/build/

# The background table: 1601 rows of 16-digit reals rewritten by fable_cosmo_rs
# on every run. The figures, JSON summaries and provenance pages that quote
# numbers from it ARE tracked; the bulk table is regenerated by one command.
/artifacts/fable/fable_background.csv
