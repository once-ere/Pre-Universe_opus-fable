(* fableSpinor: a real 16-component field carrying an irreducible
   representation of the universal cover of the REAL O(4,4), together with its
   Lagrangian, energy-momentum tensor, and the exactly solvable background
   cosmology that follows from them.

   Run:  wolframscript -file wolfram/fable_spinor.wls 2>&1 | tee logs/fable_spinor.log
*)

ClearAll["Global`*"];

dimension = 8;
spinorDimension = 16;
eta4488 = DiagonalMatrix[{1, 1, 1, 1, -1, -1, -1, -1}];
identity16 = IdentityMatrix[spinorDimension];

cosmologyAssumptions =
  scaleS > 0 && massM >= 0 && couplingLambda > 0 &&
  0 < indexN < 1 && xiTorsion \[Element] Reals &&
  gammaFlow > 0 && 0 < bridgeS < 1 && 0 < bridgeS0 < 1 &&
  hubbleH > 0 && efolds \[Element] Reals && scaleS0 > 0;

(* ------------------------------------------------------------------ *)
(* 1. The real Clifford algebra Cl(4,4) on the exterior algebra of R^4. *)
(* Even forms occupy components 1..8 (type one); odd forms 9..16.       *)
(* ------------------------------------------------------------------ *)

exteriorBasis = Join[
  Select[Range[0, 15], EvenQ[DigitCount[#, 2, 1]] &],
  Select[Range[0, 15], OddQ[DigitCount[#, 2, 1]] &]
];
basisPosition[state_] := First[FirstPosition[exteriorBasis, state]];
occupiedQ[state_, index_] := BitAnd[state, 2^(index - 1)] != 0;
orientationSign[state_, index_] := (-1)^Total[
  Boole[occupiedQ[state, #]] & /@ Range[index - 1]
];

creationOperator[index_] := SparseArray[
  Table[
    With[{state = exteriorBasis[[column]]},
      If[occupiedQ[state, index], Nothing,
        {basisPosition[state + 2^(index - 1)], column} ->
          orientationSign[state, index]]
    ],
    {column, spinorDimension}
  ],
  {spinorDimension, spinorDimension}
];

annihilationOperator[index_] := SparseArray[
  Table[
    With[{state = exteriorBasis[[column]]},
      If[occupiedQ[state, index],
        {basisPosition[state - 2^(index - 1)], column} ->
          orientationSign[state, index],
        Nothing]
    ],
    {column, spinorDimension}
  ],
  {spinorDimension, spinorDimension}
];

gamma4488 = Join[
  Table[Normal[creationOperator[i] + annihilationOperator[i]], {i, 4}],
  Table[Normal[creationOperator[i] - annihilationOperator[i]], {i, 4}]
];

cliffordResidual = Table[
  gamma4488[[a]] . gamma4488[[b]] + gamma4488[[b]] . gamma4488[[a]] -
    2 eta4488[[a, b]] identity16,
  {a, dimension}, {b, dimension}
];

chirality = Dot @@ gamma4488;

lorentzGenerator = Table[
  (1/4) (gamma4488[[a]] . gamma4488[[b]] - gamma4488[[b]] . gamma4488[[a]]),
  {a, dimension}, {b, dimension}
];

(* ------------------------------------------------------------------ *)
(* 2. The spinor metric.                                                *)
(* C is the product of the four gammas of positive square. It is        *)
(* symmetric, C.gamma^a is antisymmetric, and C.S^{ab} is antisymmetric, *)
(* so Psi^T C Psi is a nonvanishing invariant of a commuting real field  *)
(* while the vector current Psi^T C gamma^a Psi vanishes identically.    *)
(* ------------------------------------------------------------------ *)

spinorMetric = gamma4488[[1]] . gamma4488[[2]] . gamma4488[[3]] . gamma4488[[4]];

metricSymmetryResidual = spinorMetric - Transpose[spinorMetric];
currentAntisymmetryResidual = Table[
  spinorMetric . gamma4488[[a]] + Transpose[spinorMetric . gamma4488[[a]]],
  {a, dimension}
];
generatorInvarianceResidual = Table[
  Transpose[lorentzGenerator[[a, b]]] . spinorMetric +
    spinorMetric . lorentzGenerator[[a, b]],
  {a, dimension}, {b, dimension}
];

(* ------------------------------------------------------------------ *)
(* 3. Irreducibility under the universal cover of the REAL O(4,4).      *)
(*                                                                      *)
(* Pin(4,4) is generated by the gamma matrices themselves (lifts of the  *)
(* reflections that generate O(4,4)); Spin(4,4) is the even part. The    *)
(* real commutant of a set of matrices is the kernel of X -> [g, X].     *)
(* By real Schur / Burnside, commutant dimension 1 means the 16          *)
(* dimensional real representation is absolutely irreducible.            *)
(* ------------------------------------------------------------------ *)

(* The commutant of a set of matrices is the kernel of the stacked
   linear map X -> g.X - X.g, written with Kronecker products. *)
commutantDimension[generators_] := Length[
  NullSpace[
    Join @@ (
      KroneckerProduct[#, identity16] -
        KroneckerProduct[identity16, Transpose[#]] & /@ generators
    )
  ]
];

cliffordWord[indices_List] := If[indices === {}, identity16,
  Dot @@ (gamma4488[[#]] & /@ indices)];
allWords = cliffordWord /@ Subsets[Range[dimension]];
evenWords = cliffordWord /@ Select[Subsets[Range[dimension]], EvenQ[Length[#]] &];

spanRank[words_] := MatrixRank[Flatten /@ words];

independentGenerators = Flatten[
  Table[lorentzGenerator[[a, b]], {a, dimension - 1}, {b, a + 1, dimension}],
  1
];

pinCommutantDimension = commutantDimension[gamma4488];
spinCommutantDimension = commutantDimension[independentGenerators];
pinSpanRank = spanRank[allWords];
evenSpanRank = spanRank[evenWords];

chiralityCommutesWithSpin = Table[
  chirality . lorentzGenerator[[a, b]] - lorentzGenerator[[a, b]] . chirality,
  {a, dimension}, {b, dimension}
];
chiralityAnticommutesWithGamma = Table[
  chirality . gamma4488[[a]] + gamma4488[[a]] . chirality,
  {a, dimension}
];

(* ------------------------------------------------------------------ *)
(* 4. fableSpinor and its bilinears.                                    *)
(* ------------------------------------------------------------------ *)

fableSpinor = Table[psi[k], {k, spinorDimension}];
fableBilinear = Simplify[fableSpinor . spinorMetric . fableSpinor];
fablePseudoscalar = Simplify[
  fableSpinor . spinorMetric . chirality . fableSpinor
];
fableCurrent = Simplify[
  Table[fableSpinor . spinorMetric . gamma4488[[a]] . fableSpinor,
    {a, dimension}]
];

(* ------------------------------------------------------------------ *)
(* 5. The 3+1 Clifford subalgebra used for the homogeneous background.  *)
(* gammaTime has square +1; the three gammaSpace have square -1; all    *)
(* four anticommute, so they generate Cl(1,3) inside Cl(4,4).           *)
(* ------------------------------------------------------------------ *)

gammaTime = gamma4488[[1]];
gammaSpace = {gamma4488[[5]], gamma4488[[6]], gamma4488[[7]]};
frwGammas = Prepend[gammaSpace, gammaTime];
frwSignature = DiagonalMatrix[{1, -1, -1, -1}];
frwCliffordResidual = Table[
  frwGammas[[a]] . frwGammas[[b]] + frwGammas[[b]] . frwGammas[[a]] -
    2 frwSignature[[a, b]] identity16,
  {a, 4}, {b, 4}
];

(* ------------------------------------------------------------------ *)
(* 6. Background field equation and the exact dilution law.             *)
(*                                                                      *)
(* The homogeneous Dirac equation in a flat FLRW reduction, including    *)
(* the gpt-5.6_bridge scalar connection term, reads                      *)
(*                                                                      *)
(*   gammaTime . (Psi' + (3/2) H Psi - (1/2)(1-h) Theta Psi)             *)
(*      == (M + V'(S)) Psi.                                             *)
(*                                                                      *)
(* Everything below is derived from that equation with a GENERIC         *)
(* 16-component Psi: no component is ever specialised.                   *)
(* ------------------------------------------------------------------ *)

bridgeH[s_] := 3 s^2 - 2 s^3;
dilutionExponent[s_] := 3 - xiTorsion (1 - bridgeH[s]);

psiDerivative = Simplify[
  -(3/2) hubbleH fableSpinor +
   (1/2) (1 - bridgeH[bridgeS]) xiTorsion hubbleH fableSpinor +
   (massM + potentialSlope) gammaTime . fableSpinor
];

bilinearRate = Simplify[2 fableSpinor . spinorMetric . psiDerivative];
dilutionResidual = Simplify[
  bilinearRate + dilutionExponent[bridgeS] hubbleH fableBilinear
];

energyDensityFromSpinor = Simplify[
  fableSpinor . spinorMetric . gammaTime . (
    (massM + potentialSlope) gammaTime . fableSpinor
  )
];
energyDensityResidual = Simplify[
  energyDensityFromSpinor - (massM + potentialSlope) fableBilinear
];
currentVanishesResidual = Simplify[
  fableSpinor . spinorMetric . gammaTime . fableSpinor
];

(* ------------------------------------------------------------------ *)
(* 7. The exactly solvable background cosmology.                        *)
(* Independent variable is the number of e-folds N = Log[a].            *)
(* ------------------------------------------------------------------ *)

potential[s_] := couplingLambda s^indexN;
potentialDerivative[s_] := D[potential[u], u] /. u -> s;

energyDensity[s_] := massM s + potential[s];
pressure[s_, nu_] := Simplify[
  (nu/3) (massM s + indexN couplingLambda s^indexN) - energyDensity[s]
];
equationOfState[s_, nu_] := Simplify[pressure[s, nu]/energyDensity[s]];

bridgeSolution[n_] := bridgeS0 Exp[gammaFlow n] /
  (1 - bridgeS0 + bridgeS0 Exp[gammaFlow n]);
bridgeFlowResidual = Simplify[
  D[bridgeSolution[efolds], efolds] -
    gammaFlow bridgeSolution[efolds] (1 - bridgeSolution[efolds])
];

bilinearQuadrature[n_] := (1/gammaFlow) (
  Log[bridgeSolution[n]] + bridgeSolution[n] - bridgeSolution[n]^2
);
logBilinearSolution[n_] :=
  Log[scaleS0] - 3 n + xiTorsion (bilinearQuadrature[n] - bilinearQuadrature[0]);

closedFormResidual = Simplify[
  D[logBilinearSolution[efolds], efolds] +
    dilutionExponent[bridgeSolution[efolds]],
  0 < bridgeS0 < 1 && gammaFlow > 0 && efolds \[Element] Reals
];

continuityResidual = Simplify[
  D[energyDensity[scaleS], scaleS] * (-dilutionExponent[bridgeS] scaleS) +
    3 (energyDensity[scaleS] + pressure[scaleS, dilutionExponent[bridgeS]]),
  cosmologyAssumptions
];

teleparallelPressureResidual = Simplify[
  pressure[scaleS, 3] - (indexN - 1) couplingLambda scaleS^indexN,
  cosmologyAssumptions
];

masslessEquationOfState = Simplify[
  equationOfState[scaleS, 3] /. massM -> 0,
  cosmologyAssumptions
];

benchmarkIndex = 1 - 764/1000;
benchmarkEquationOfState = masslessEquationOfState /. indexN -> benchmarkIndex;

earlyTimeEquationOfState = Simplify[
  Limit[equationOfState[scaleS, nuSymbol], scaleS -> Infinity,
    Assumptions -> scaleS > 0 && massM > 0 && couplingLambda > 0 &&
      0 < indexN < 1 && nuSymbol \[Element] Reals]
];
lateTimeEquationOfState = Simplify[
  Limit[equationOfState[scaleS, nuSymbol], scaleS -> 0,
    Assumptions -> scaleS > 0 && massM > 0 && couplingLambda > 0 &&
      0 < indexN < 1 && nuSymbol \[Element] Reals]
];

(* The second mechanism: w acquires an explicit dependence on the bridge   *)
(* field through nu, which survives even when the potential is switched    *)
(* off.  It vanishes exactly when xiTorsion == 0 or the bridge is frozen.  *)
secondMechanismSensitivity = Simplify[
  D[equationOfState[scaleS, dilutionExponent[bridgeS]], bridgeS],
  cosmologyAssumptions
];
secondMechanismVanishesWithoutTorsion = Simplify[
  secondMechanismSensitivity /. xiTorsion -> 0,
  cosmologyAssumptions
];
secondMechanismSurvivesWithoutPotential = Simplify[
  secondMechanismSensitivity /. couplingLambda -> 0
];

zeroQ[0] := True;
zeroQ[expression_] := TrueQ[Simplify[expression == 0, cosmologyAssumptions]];
(* Exact integer and rational matrices: an element is zero iff it is the
   literal 0, so no simplification is involved. *)
zeroArrayQ[expression_] := AllTrue[Flatten[{expression}], TrueQ[# == 0] &];

(* ------------------------------------------------------------------ *)
(* 8. Verification report.                                             *)
(* ------------------------------------------------------------------ *)

tests = {
  VerificationTest[Dimensions[gamma4488], {8, 16, 16},
    TestID -> "fable-gamma-dimensions"],
  VerificationTest[And @@ (IntegerQ /@ Flatten[gamma4488]), True,
    TestID -> "fable-gammas-are-real-integer-matrices"],
  VerificationTest[zeroArrayQ[cliffordResidual], True,
    TestID -> "fable-clifford-4-plus-4"],
  VerificationTest[zeroArrayQ[frwCliffordResidual], True,
    TestID -> "fable-frw-clifford-subalgebra"],
  VerificationTest[zeroArrayQ[metricSymmetryResidual], True,
    TestID -> "fable-spinor-metric-symmetric"],
  VerificationTest[zeroArrayQ[currentAntisymmetryResidual], True,
    TestID -> "fable-metric-times-gamma-antisymmetric"],
  VerificationTest[zeroArrayQ[generatorInvarianceResidual], True,
    TestID -> "fable-bilinear-is-spin-invariant"],
  VerificationTest[zeroArrayQ[chiralityCommutesWithSpin], True,
    TestID -> "fable-chirality-commutes-with-spin-generators"],
  VerificationTest[zeroArrayQ[chiralityAnticommutesWithGamma], True,
    TestID -> "fable-chirality-anticommutes-with-gammas"],
  VerificationTest[pinSpanRank, 256,
    TestID -> "fable-pin-words-span-full-real-matrix-algebra"],
  VerificationTest[pinCommutantDimension, 1,
    TestID -> "fable-pin-commutant-is-one-dimensional"],
  VerificationTest[evenSpanRank, 128,
    TestID -> "fable-even-words-span-half-the-algebra"],
  VerificationTest[spinCommutantDimension, 2,
    TestID -> "fable-spin-commutant-is-two-dimensional"],
  VerificationTest[fableBilinear === 0, False,
    TestID -> "fable-scalar-bilinear-is-nonzero"],
  VerificationTest[zeroArrayQ[fableCurrent], True,
    TestID -> "fable-vector-current-vanishes-for-commuting-spinor"],
  VerificationTest[fablePseudoscalar === 0, False,
    TestID -> "fable-pseudoscalar-bilinear-is-nonzero"],
  VerificationTest[zeroQ[currentVanishesResidual], True,
    TestID -> "fable-time-current-vanishes"],
  VerificationTest[zeroQ[dilutionResidual], True,
    TestID -> "fable-bilinear-dilution-law"],
  VerificationTest[zeroQ[energyDensityResidual], True,
    TestID -> "fable-energy-density-from-generic-spinor"],
  VerificationTest[zeroQ[bridgeFlowResidual], True,
    TestID -> "fable-bridge-logistic-flow"],
  VerificationTest[zeroQ[closedFormResidual], True,
    TestID -> "fable-closed-form-bilinear-solution"],
  VerificationTest[zeroQ[continuityResidual], True,
    TestID -> "fable-covariant-conservation"],
  VerificationTest[zeroQ[teleparallelPressureResidual], True,
    TestID -> "fable-teleparallel-pressure-reduces-to-standard-form"],
  VerificationTest[Simplify[masslessEquationOfState - (indexN - 1)], 0,
    TestID -> "fable-massless-equation-of-state-is-constant"],
  VerificationTest[benchmarkEquationOfState, -764/1000,
    TestID -> "fable-reproduces-minus-0-point-764-benchmark"],
  VerificationTest[Simplify[earlyTimeEquationOfState - (nuSymbol/3 - 1)], 0,
    TestID -> "fable-early-time-is-dark-matter-like"],
  VerificationTest[
    Simplify[lateTimeEquationOfState - (indexN nuSymbol/3 - 1)], 0,
    TestID -> "fable-late-time-is-dark-energy-like"],
  VerificationTest[zeroQ[secondMechanismVanishesWithoutTorsion], True,
    TestID -> "fable-second-mechanism-needs-torsion"],
  VerificationTest[zeroQ[secondMechanismSurvivesWithoutPotential], False,
    TestID -> "fable-second-mechanism-survives-without-potential"],
  VerificationTest[zeroQ[secondMechanismSensitivity], False,
    TestID -> "fable-equation-of-state-depends-on-bridge-field"]
};

report = TestReport[tests];
Print["Tests run: ", Length[tests]];
Print["Messages raised: ",
  Length[report["TestsFailedWithMessages"]]];
Print["Pin(4,4) commutant dimension          : ", pinCommutantDimension];
Print["Spin(4,4) commutant dimension         : ", spinCommutantDimension];
Print["Rank of the 256 real Clifford words   : ", pinSpanRank];
Print["Rank of the 128 even Clifford words   : ", evenSpanRank];
Print["Massless equation of state            : ", masslessEquationOfState];
Print["Benchmark index n for w = -0.764      : ", N[benchmarkIndex, 10]];
Print["Early-time equation of state          : ", earlyTimeEquationOfState];
Print["Late-time equation of state           : ", lateTimeEquationOfState];
Print["Tests succeeded: ", report["TestsSucceededCount"]];
Print["Tests failed: ", report["TestsFailedCount"]];

If[report["TestsFailedCount"] > 0 && $FrontEnd === Null, Exit[1]];
